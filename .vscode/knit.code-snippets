	"Component": {
		"scope": "lua,luau",
		"prefix": [
			"component"
		],
		"description": "Component Template with HierarchyIs and Trove",
		"body": [
			"--!strict",
			"--- Services ---",
			"",
			"--- Imports ---",
			"local Component = require(script.Parent.Parent.Parent.Packages.Component)",
			"local Trove = require(script.Parent.Parent.Parent.Packages.Trove)",
			"",
			"local WidgetService = require(script.Parent.Parent.Parent.Services.WidgetService)",
			"",
			"local HierarchyIs = require(script.Parent.Parent.Parent.ComponentExtensions.HierarchyIs)",
			"",
			"--- Types ---",
			"type ComponentInstance = ${3:Instance} & {",
			"\t${4}",
			"}",
			"",
			"type Component = {",
			"\tInstance: ComponentInstance,",
			"\t_trove: Trove.Trove,",
			"}",
			"",
			"--- Variables ---",
			"",
			"--- Functions ---",
			"",
			"--- ${2:$TM_FILENAME_BASE} Component ---",
			"local ${1:$TM_FILENAME_BASE} = Component.new({",
			"\tTag = \"${1:$TM_FILENAME_BASE}\",",
			"\tAncestors = { Workspace },",
			"\tExtensions = { HierarchyIs({}) } :: any,",
			"})",
			"",
			"function ${1:$TM_FILENAME_BASE}.Construct(self: Component)",
			"\tself._trove = Trove.new()",
			"end",
			"",
			"function ${1:$TM_FILENAME_BASE}.Start(self: Component)",
			"\t",
			"end",
			"",
			"function ${1:$TM_FILENAME_BASE}.Stop(self: Component)",
			"\tself._trove:Destroy()",
			"end",
			"",
			"return ${1:$TM_FILENAME_BASE}"
		]
	},
}
